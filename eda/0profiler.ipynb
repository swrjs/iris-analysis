    "import pandas as pd \n",
    "from data_profiling import ProfileReport\n",
    "\n",
    "df = pd.read_csv('../data/iris.csv')\n",
    "\n",
    "profile = ProfileReport(df, title=\"Iris Data Profiling Report\", explorative=True)\n",
    "\n",
    "profile.to_file(\"../profiling_reports/iris_data_profiling_report.html\")"
